library(tidyr)
library(ggplot2)

students <- data.frame(
  student = c("reethu", "deepu", "krishna", "priya", "raja"),
  math = c(99, 98, 97, 96, 95),
  science = c(100, 68, 79, 89, 90),
  english = c(56, 78, 90, 78, 99),
  hours = c(1, 2, 3, 4, 5)
)

head(students)

long_df <- pivot_longer(
  students,
  cols = c(math, science, english),
  names_to = "subject",
  values_to = "score"
)

ggplot(students, aes(x = math)) +
  geom_histogram(
    binwidth = 8,
    fill = "#9b59b6",
    color = "black",
    alpha = 0.8
  ) +
  geom_vline(
    aes(xintercept = mean(math)),
    color = "red",
    linetype = "dashed",
    linewidth = 1
  ) +
  labs(
    title = "Distribution of Math Scores",
    x = "Score",
    y = "Count"
  ) +
  theme_classic()
